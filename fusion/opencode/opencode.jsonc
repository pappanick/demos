// Merge into ~/.config/opencode/opencode.jsonc — these are the OpenRouter FALLBACK
// models for the Kimi, GLM, Qwen, and DeepSeek seats. The primaries run on the
// OpenCode Go subscription (opencode-go/*), which ships in opencode's catalog and
// needs no registration. OpenRouter entries must be registered explicitly because
// opencode's cached catalog may lag OpenRouter's live one.
// Model IDs are pinned to match fusion/skills/fusion/SKILL.md; CI asserts they agree.
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro (OpenRouter)"
        },
        "z-ai/glm-5.3": {
          "name": "GLM 5.3 (OpenRouter)"
        },
        "qwen/qwen3.8-max-prime": {
          "name": "Qwen3.8 Max Prime (OpenRouter)"
        },
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (OpenRouter)"
        }
      }
    }
  }
}
